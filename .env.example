# ── 1. AI 模型服务密钥（按需填写你使用的协议对应密钥） ──
# GEMINI_API_KEY: Gemini 原生协议密钥
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# CUSTOM_AI_API_KEY: OpenAI 兼容协议（DeepSeek / OpenRouter / OneAPI 等）密钥
CUSTOM_AI_API_KEY=""
# ANTHROPIC_API_KEY: Anthropic Claude (/v1/messages) 或兼容中转站密钥
ANTHROPIC_API_KEY=""

# ── 2. YouTube 平台凭据（多频道共用同一组 GCP 应用凭据） ──
# APP_URL: 当前工作台对外访问的完整 HTTPS 根地址（用于拼接 OAuth 回调地址）
APP_URL="MY_APP_URL"
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# ── 3. 对象存储与数据库接口凭据（仅在切换到对应外部驱动时填写） ──
# Cloudflare R2 / AWS S3 / MinIO（Endpoint、Bucket、前缀在网页「频道与设置」直接保存）
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# WebDAV（Nextcloud / Alist / 群晖 NAS，地址与前缀在网页「频道与设置」直接保存）
WEBDAV_USERNAME=""
WEBDAV_PASSWORD=""

# 自定义 JSON 数据库文件路径 / PostgreSQL 连接串（可选）
STORAGE_DB_PATH="./data/studio-db.json"
DATABASE_URL=""

# ── 4. 可选：仅当使用外部 GitHub Actions Worker 渲染回调时按需配置（默认单机部署无需填写） ──
# TOKEN_ENC_KEY=""
# WORKER_TOKEN=""
# WORKER_HMAC_SECRET=""
# CRON_SECRET=""
